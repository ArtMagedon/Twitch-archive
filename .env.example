# Порт веб-интерфейса на хосте
APP_PORT=8080

# Путь на хосте, куда Podman будет сохранять записи.
# Можно указать абсолютный путь, например /srv/twitch-archive/recordings
RECORDINGS_HOST_DIR=./recordings

# Параметры мониторинга
POLL_INTERVAL_SECONDS=60
STREAM_CHECK_TIMEOUT_SECONDS=25
STREAM_QUALITY=best
TZ=Europe/Bucharest
